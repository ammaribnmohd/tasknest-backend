# Copy this file to ".env" in the taskflow-backend folder and fill in the values.
# ".env" is git-ignored. NEVER commit real credentials.
# Spring Boot loads it via `spring.config.import=optional:file:.env[.properties]`.

# Brevo -> Settings -> SMTP & API -> SMTP
MAIL_USERNAME=your-brevo-smtp-login@smtp-brevo.com
MAIL_PASSWORD=your-generated-brevo-smtp-key
# Must be a sender verified in Brevo
MAIL_FROM=your-verified-sender@example.com

# Long random string (e.g. 48+ chars). Used to HMAC-hash OTPs before storing them.
OTP_HMAC_SECRET=change-me-to-a-long-random-string

# Optional overrides
# MONGODB_URI=mongodb://127.0.0.1:27017/taskflow
# CORS_ALLOWED_ORIGINS=http://localhost:4200
# SESSION_COOKIE_SECURE=false

